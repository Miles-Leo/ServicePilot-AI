# Configuration example only. ServicePilot does NOT automatically load .env.
# Set this variable in PowerShell before starting Python/Streamlit.
# Placeholder only: NOT a usable key. Never put a real API key in this template.
DASHSCOPE_API_KEY=REPLACE_WITH_YOUR_DASHSCOPE_API_KEY
# Optional chat-only endpoint. Must match your DashScope API key region.
# Embeddings continue using the native DashScope adapter, independently of this URL.
DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
